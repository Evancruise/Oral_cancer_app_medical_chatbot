        <div class="card">
            <h3>回診摘要</h3>
            <table aria-label="回診摘要">
                <thead>
                    <tr>
                        <th>日期</th>
                        <th>科別 / 醫師</th>
                        <th>診斷結果</th>
                        <th>醫師建議</th>
                    </tr>
                </thead>
                <tbody>
                <tr>
                    <td>2025-09-18</td>
                    <td>家醫科 / 謝依婷</td>
                    <td>正常現象</td>
