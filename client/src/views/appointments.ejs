<div class="appointments-container">
    <div class="grid cols-2">
        <% if (priority === 1) { %>
        <div class="card">
            <div class="row">
                <h3 style="margin:0">即將到來</h3>
                <table aria-label="即將到來回診">
                    <thead>
                        <tr>
                        <th style="width:18%">日期時間</th>
                        <!-- <th>科別</th> -->
                        <th style="width:14%">醫師</th>
                        <th style="width:14%">地點</th>
                        <th style="width:14%">提醒</th>
                        <th style="width:20%">狀態</th>
                        <th style="width:20%">操作</th>
                        </tr>
                    </thead>
                    <tbody id="upcomingList">
                    <% Object.entries(grouped_appointments).forEach(([day, items]) => { %>
                        <% items.forEach(ap => { %>
                            <tr>
                                <td><%= typeof formatDateTime === 'function' ? formatDateTime(ap.date) : new Date(ap.date).toISOString().replace('T', ' ').slice(0,16) %></td>
                                <!-- <td><%= ap.dept || '-' %></td> -->
                                <td><%= ap.doctor_name || '-' %></td>
                                <td><%= ap.location || '-' %> </td>
                                <td>
                                <%= 
                                    ap.notify_timer === '1daybefore' ? '前一天' :
                                    ap.notify_timer === '1hourbefore' ? '前 1 小時' :
                                    ap.notify_timer === 'now' ? '當下' :
                                    '未設定'
                                %>
                                </td>
                                <td>
                                <%= 
                                    ap.checkin === true ? '確定出席' : '未決定'
                                %>
                                </td>
                                <td>
                                    <button class="btn secondary btn-edit" 
                                            data-id="<%= ap.id %>" 
                                            data-date="<%= ap.date %>" 
                                            data-doctor="<%= ap.doctor_name || '' %>"
                                            data-location="<%= ap.location || '' %>"
                                            data-notify="<%= ap.notify_switch ? 'true' : 'false' %>"
                                            data-timer="<%= ap.notify_timer || '' %>"
                                            data-notes="<%= ap.notes || '' %>">
                                        編輯 / 查看提醒
                                    </button>
                                    <button type="button" name="action" value="confirm" class="btn secondary btn-confirm" 
                                            data-id="<%= ap.id %>"
                                            data-date="<%= ap.date %>" 
                                            data-doctor="<%= ap.doctor_name || '' %>"
                                            data-location="<%= ap.location || '' %>"
                                            data-notify="<%= ap.notify_switch ? 'true' : 'false' %>"
                                            data-timer="<%= ap.notify_timer || '' %>"
                                            data-notes="<%= ap.notes || '' %>"
                                            data-token="<%= token %>">
                                            確認出席
                                    </button>
                                    <button type="button" name="action" value="cancel" class="btn danger btn-cancel" 
                                            data-id="<%= ap.id %>"
                                            data-date="<%= ap.date %>" 
                                            data-doctor="<%= ap.doctor_name || '' %>"
                                            data-location="<%= ap.location || '' %>"
                                            data-notify="<%= ap.notify_switch ? 'true' : 'false' %>"
                                            data-timer="<%= ap.notify_timer || '' %>"
                                            data-notes="<%= ap.notes || '' %>"
                                            data-token="<%= token %>">
                                            取消預約
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    <% }) %>
                    </tbody>
                </table>
            </div>
            <!-- <button class="btn secondary" id="btnAddFromUpcoming">新增/更改提醒</button> -->
            <div class="center-btn">
                <button class="btn secondary" id="btnAddFromUpcoming">新增提醒</button>
            </div>
        </div>
        <% } %>

