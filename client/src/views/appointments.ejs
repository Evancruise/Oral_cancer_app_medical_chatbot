<div class="modal-footer-1">
    <div class="center-btn">
        <a href="/api/auth/dashboard?token=<%= token %>" class="btn-return"> <%= t("return") %> </a>
    </div>
</div>

<div class="modal fade" id="ReminderModal" tabindex="-1" aria-labelledby="ReminderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" enctype="multipart/form-data" class="card p-4" id="reminderForm">
                <div class="modal-header custom-modal-header">
                    <h5 class="modal-title animated-title" id="newRecordModalLabel">
                        <i class="fas fa-plus fa-beat"></i> 新增回診提醒
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <input type="hidden" name="name" id="name" value="<%= name %>">
                <input type="hidden" name="token" id="token" value="<%= token %>">
                <input type="hidden" name="email" id="email" value="<%= email %>">

                <div class="row">
                    <div style="flex:1; min-width:220px">
                        <label for="date">日期時間</label>
                        <input type="datetime-local" id="date" name="date" required />
                    </div>
                    <!-- <div style="flex:1; min-width:160px">
                        <label for="dept">科別</label>
                        <select id="dept">
                            <option>內科</option>
                            <option>家醫科</option>
                            <option>口腔外科</option>
                            <option>耳鼻喉科</option>
                        </select>
                    </div> -->
                    <div style="flex:1; min-width:160px">
                        <label for="doctor_name">醫師</label>
                        <input id="doctor_name-edit" name="doctor_name" placeholder="例如：王大明" />
                    </div>
                    <div class="row">
                        <div style="flex:1; min-width:220px">
                            <label for="location">院區 / 地點</label>
                            <input id="location" name="location" placeholder="例如：信義院區 A 棟" />
                        </div>
                    </div>
                    <div class="form-inline">
                        <label>提醒時點</label>
                        <select id="notify_timer-edit" name="notify_timer">
                            <option id="tMinus1d" value="1daybefore">前 1 天</option>
                            <option id="tMinus1h" value="1hourbefore">前 1 小時</option>
                            <option id="tNow" value="now">當下</option>
                        </select>
                    </div>
                    <div class="form-inline">
                        <label for="notify_switch">開啟通知</label>
                        <input type="checkbox" name="notify_switch" id="notify_switch" />
                    </div>
                    <label for="notes">備註</label>
                    <textarea id="notes" name="notes" placeholder="此欄位只能由醫師填入" <% if (priority !== 1) { %> disabled <% }%>></textarea>
                    <!-- <p id="reminderHint" class="muted">儲存後即可觸發伺服器排程（例如：Celery + Redis）。</p> -->
                    <div class="row" style="margin-top:8px">
                        <button type="submit" name="action" value="create" class="btn" id="btnAddReminder">新增提醒</button>
                        <button type="button" class="btn" data-bs-dismiss="modal"> <%= t("cancel") %> </button>
                        <!-- <button class="btn secondary" type="reset">清除</button> -->
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="modal fade" id="EditReminderModal" tabindex="-1" aria-labelledby="EditReminderModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="POST" enctype="multipart/form-data" class="card p-4" id="reminderEditForm">
                <div class="modal-header custom-modal-header">
                    <h5 class="modal-title animated-title" id="editRecordModalLabel">
                        <i class="fas fa-plus fa-beat"></i> 編輯回診提醒
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                
                <input type="hidden" name="name" id="name-edit" value="<%= name %>">
                <input type="hidden" name="token" id="token-edit" value="<%= token %>">
                <input type="hidden" name="email" id="email-edit" value="<%= email %>">

                <div class="row">
                    <div style="flex:1; min-width:220px">
                        <label for="date">日期時間</label>
                        <input type="datetime-local" id="date-edit" name="date" required />
                    </div>
                    <div style="flex:1; min-width:160px">
                        <label for="doctor_name">醫師</label>
                        <input id="doctor_name-edit" name="doctor_name" placeholder="例如：王大明" />
                    </div>
                    <div class="row">
                        <div style="flex:1; min-width:220px">
                            <label for="location">院區 / 地點</label>
                            <input id="location-edit" name="location" placeholder="例如：信義院區 A 棟" />
                        </div>
                    </div>
                    <div class="form-inline">
                        <label>提醒時點</label>
                        <select id="notify_timer-edit" name="notify_timer">
                            <option id="tMinus1d" value="1daybefore">前 1 天</option>
                            <option id="tMinus1h" value="1hourbefore">前 1 小時</option>
                            <option id="tNow" value="now">當下</option>
                        </select>
                    </div>
                    <div class="form-inline">
                        <label for="notify_switch">開啟通知</label>
                        <input type="checkbox" id="notify_switch-edit" name="notify_switch" />
                    </div>
                    <label for="notes">備註</label>
                    <textarea id="notes-edit" name="notes" placeholder="此欄位只能由醫師填入" <% if (priority !== 1) { %> disabled <% }%>></textarea>
                    <div class="row" style="margin-top:8px">
                        <button type="submit" name="action" value="edit" class="btn" id="btnEditReminder">儲存提醒</button>
                        <button type="submit" name="action" value="delete" class="btn" id="btnDeleteReminder">刪除預約</button>
                        <button type="button" class="btn" data-bs-dismiss="modal"> <%= t("cancel") %> </button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>